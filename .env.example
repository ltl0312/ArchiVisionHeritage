# 复制为 .env 并填写实际值（.env 不入库）

# ── 必填 ──
DB_PASSWORD=

# JWT 签名密钥（必填，无默认值）
#   ⚠️ 绝不要使用仓库历史文档里出现过的那串密钥 —— 公开仓库里的默认密钥
#      等于公开密钥，任何人都能自签 role=ADMIN 的令牌。
#   生成方式（任选其一）：
#     openssl rand -hex 48
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── 可选覆盖项（不设置则使用 yml 默认值）──
# VGGT_API_URL=http://127.0.0.1:8000/v1/analyze
