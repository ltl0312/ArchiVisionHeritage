# ========== 依赖 & 构建产物 ==========
node_modules/
dist/
# 并行/分片验证用的临时构建输出（如 vite build --outDir dist-check-xxx）
dist-*/
target/
*.class
release-build/
release-new/
*.asar
*.tar.gz

# 回归验证产出的截图与报告（体积大、可随时重跑生成）
.workbuddy/shots/
.workbuddy/shots-*/

# 集成测试的资产输出目录（application-test.yml 的 zhiguan.assets.local-path）
# 幻筑任务现在会真实落盘占位封面与 GLB，故该目录必然产生文件
backend/test-assets/

#========== 脚本===========
# *.py
_pycache/
*.pyc
.bat
# ⚠️ 必须锚定到仓库根：裸写 `api/` 会在**任意层级**匹配名为 api 的目录，
#    从而把 frontend/src/api/ 一起忽略。已跟踪的文件不受影响，但后加入的
#    文件会被静默吞掉（frontend/src/api/upload.js 就这样丢失过，
#    导致 CI 与任何全新克隆都无法构建前端）。
/api/

# ========== 环境 & 日志 ==========
.env.local
*.log
logs/

# ========== 压缩包 & 临时文件 ==========
*.zip
*.tar.*

# ========== IDE 配置（团队协作友好） ==========
# .idea/
# .vscode/
# 仅忽略个人状态/缓存，保留团队共享设置
.idea/workspace.xml
.idea/shelf/
.vscode/*.code-workspace
.vscode/state.*
.claude/
prompt/
.env
vggt-api/__pycache__/
vggt-api/api_uploads/

# ========== 按需调整（建议取消全局忽略） ==========
# *.sql  -> 改为忽略特定备份，如: backup_*.sql
# deploy/ -> 部署脚本/配置通常需提交，仅忽略敏感文件